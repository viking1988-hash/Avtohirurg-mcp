# Isolated staging operator API; never replace the mock worker image.
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY staging/outbox_operator_api.mjs ./staging/outbox_operator_api.mjs
USER node
EXPOSE 8787
CMD ["node", "staging/outbox_operator_api.mjs"]
