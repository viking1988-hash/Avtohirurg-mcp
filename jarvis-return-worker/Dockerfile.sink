FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --uid 10001 --create-home sink && mkdir -p /data && chown sink:sink /data
COPY isolated_receiver_http.py disposable_sink.py /app/
COPY tests/test_receiver_idempotency_reference.py /app/tests/test_receiver_idempotency_reference.py
USER sink
EXPOSE 8080
CMD ["python", "/app/disposable_sink.py"]
