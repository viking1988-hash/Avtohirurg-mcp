FROM prom/prometheus:v3.5.0 AS prometheus
FROM python:3.11-alpine3.21
COPY --from=prometheus /bin/prometheus /bin/prometheus
COPY --from=prometheus /bin/promtool /bin/promtool
COPY --from=prometheus /etc/prometheus/prometheus.yml /etc/prometheus/prometheus.yml
WORKDIR /opt/prometheus-backup
COPY ops/prometheus/backup_once.py ./backup_once.py
COPY ops/prometheus/package_completed_snapshot.py ./package_completed_snapshot.py
COPY ops/prometheus/upload_verified_archive.py ./upload_verified_archive.py
COPY ops/prometheus/validate_snapshot_archive.py ./validate_snapshot_archive.py
COPY ops/prometheus/validate_restored_tsdb.py ./validate_restored_tsdb.py
COPY ops/prometheus/disposable_railway_backup_e2e.py ./disposable_railway_backup_e2e.py
ENV PYTHONUNBUFFERED=1
USER 0:0
