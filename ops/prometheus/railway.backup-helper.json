{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/prometheus/Dockerfile.backup-helper"
  },
  "deploy": {
    "startCommand": "python3 /opt/prometheus-backup/backup_receiver.py",
    "restartPolicyType": "ALWAYS",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30
  }
}
